# 「梗一下」服务端环境变量示例（复制为 .env 使用，切勿提交真实密钥）
#
# ── 模型接入 ──────────────────────────────────────────────
# provider：openai-compat | ollama | mock
LLM_PROVIDER=openai-compat
LLM_BASE_URL=https://ollama.com/v1
LLM_MODEL=deepseek-v4.1-flash
# 二选一：直接写密钥，或指向一个已存在、含 LLM_API_KEY 的 .env 文件
# LLM_API_KEY=your_key_here
# LLM_API_KEY_FILE=/path/to/your/secrets.env
LLM_TIMEOUT_MS=120000
# 推理模型的思考 token 也计入输出预算，需给足（本项目实测 8000 可稳定输出）
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.85
LLM_JSON_MODE=auto
LLM_MAX_CONCURRENCY=3
LLM_RETRY_ON_ERROR=1

# ── 生成保护 ──────────────────────────────────────────────
GEN_ENABLED=true
GEN_DAILY_LIMIT=200
GEN_PER_IP_LIMIT=6
GEN_PER_IP_WINDOW_MS=600000
GEN_DEDUPE_WINDOW_MS=120000

# ── 服务与存储 ────────────────────────────────────────────
PORT=8765
HOST=127.0.0.1
DB_PATH=./data/gengxia.db
BODY_LIMIT_BYTES=65536
